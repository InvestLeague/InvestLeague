e; border: 0; background: var(--surface); border-radius: 8px; aspect-ratio: 1 / 1; max-width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 600; font-variant-numeric: tabular-nums; font-size: 15px; padding: 0; }\n.day.blank { background: transparent; }\n.day.we { color: var(--muted); }\n.day.fer .dn { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }\n.day.in { background: var(--accent-soft); }\n.day.edge { background: var(--accent); color: var(--accent-ink); }\n.day .marks { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); display: flex; gap: 2px; }\n.day .marks i { width: 6px; height: 6px; border-radius: 50%; background: var(--c); }\n.day:disabled { opacity: .35; cursor: default; }\n.picksum { margin-top: 10px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.picksum div { background: var(--surface-2); border-radius: 10px; padding: 8px 10px; font-size: 13px; }\n.picksum b { display: block; font-size: 15px; }\n.picksum .cur { box-shadow: 0 0 0 2px var(--accent) inset; }\n\n/* faixa resumo individual */\n.strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 8px; }\n.strip .m { min-width: 0; }\n.strip .m span { font-size: 11px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }\n.strip .t { position: relative; height: 22px; background: var(--surface-2); border-radius: 5px; overflow: hidden; }\n.strip .t b { position: absolute; top: 0; bottom: 0; background: var(--c); }\n.strip .t .gone { position: absolute; top: 0; bottom: 0; right: 0; background: repeating-linear-gradient(135deg, var(--line) 0 3px, transparent 3px 6px); }\n\n/* ---------- painel ---------- */\n.dash { max-width: 1240px; margin: 0 auto; padding: 16px 16px 48px; display: grid; gap: 16px; }\n.kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }\n.kpi { background: var(--