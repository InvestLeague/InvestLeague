2px dashed var(--ink); z-index: 2; }\n.trk .dsl { position: absolute; top: 0; bottom: 0; right: 0; background: repeating-linear-gradient(135deg, var(--muted) 0 2px, transparent 2px 6px); opacity: .55; z-index: 2; }\n.trk .pend { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: var(--pend); background: repeating-linear-gradient(45deg, var(--pend-soft) 0 6px, transparent 6px 12px); }\n.trk .badrow { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); z-index: 4; }\n.axis { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 8px; margin-bottom: 4px; }\n.axis .ticks { position: relative; height: 16px; font-size: 11px; color: var(--muted); }\n.axis .ticks span { position: absolute; transform: translateX(-50%); white-space: nowrap; font-variant-numeric: tabular-nums; }\n.axis .ticks span.l0 { transform: none; }\n\n.status-cols { display: grid; gap: 12px; }\n.st-item { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; padding: 10px; border-radius: 10px; background: var(--surface-2); align-items: center; }\n.st-item ul { grid-column: 1 / -1; margin: 2px 0 0; padding-left: 18px; font-size: 13px; }\n.st-item small { color: var(--muted); font-size: 12px; display: block; }\n.evl { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }\n.evl li { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 14px; }\n.evl li:last-child { border-bottom: 0; }\n.evl .evd { font-size: 12px; color: var(--muted); }\n.evl .evd b { display: block; font-family: var(--f-display); font-size: 20px; color: var(--ink); line-height: 1; }\n.evl small { display: block; color: var(--muted); font-size: 13px; }\n@media (min-width: 960px) { .evl { grid-template-columns: 1fr 1fr; column-gap: 24px; } }\n.modal { position: fixed; inset: 0; background: rgb(0 0 0 / .45); z-index: 50; display: flex; align-items: flex-end; justify-content: center; padding: 16px; }\n.modal .card { width: 100%; max-width: 560px; max-height: 85vh; overflow: auto; }\n.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(90px + env(safe-area-inset-bottom, 0px)); background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: 10px; font-weight: 600; z-index: 60; max-width: calc(100% - 32px); }\n.done-screen { text-align: left; }\n.done-screen .big-ok { font-family: var(--f-display); font-size: 40px; color: var(--ok); font-weight: 700; line-height: 1; }\n.empty { color: var(--muted); font-size: 14px; padding: 8px 0; }\n\n@media (min-width: 640px) {\n  .kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .names { grid-template-columns: 1fr 1fr 1fr; }\n  .map .row, .axis { grid-template-columns: 150px minmax(0, 1fr); }\n  .dcal .day { min-height: 78px; padding: 6px; }\n  .dcal .day .dn { font-size: 14px; }\n  .dcal .day .cnt b { font-size: 22px; }\n  .modal { align-items: center; }\n}\n@media (min-width: 960px) {\n  .dash { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: start; }\n  .dash .full { grid-column: 1 / -1; }\n  .status-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }\n}\n@media (prefers-reduced-motion: no-preference) {\n  .day, .btn, .opt, .cat-btn, .name-btn { transition: background-color .12s, box-shadow .12s; }\n}\n@media (forced-colors: active) {\n  .sw, .trk .bar, .strip .t b { forced-color-adjust: none; }\n}\n</style>\n\n<header class=\"top\">\n  <div class=\"top-in\">\n    <div class=\"brand\">\n      <span class=\"eyebrow\">EsAO · Curso de Infantaria</span>\n      <h1>Levantamento de afastamentos</h1>\n    </div>\n    <div class=\"views\" id=\"views\" role=\"group\" aria-label=\"Escolher tela\" hidden>\n      <button id=\"v-form\" data-act=\"view\" data-v=\"form\" aria-pressed=\"true\">Preencher</button>\n      <button id=\"v-dash\" data-act=\"view\" data-v=\"dash\" aria-pressed=\"false\">Painel</button>\n    </div>\n    <div class=\"conn\" id=\"conn\"><i></i><span>Conectando à base…</span></div>\n  </div>\n</header>\n<div class=\"banner\" id=\"banner\" hidden></div>\n<main id=\"app\"></main>\n<div id=\"layer\"></div>\n\n<script>\n\"use strict\";\n/* ======================= dados fixos ======================= */\nconst MILITARES = [\n  [\"barroso-magno\", \"Maj Barroso Magno\"], [\"modesto\", \"Maj Modesto\"], [\"andrews\", \"Maj Andrews\"],\n  [\"pimenta\", \"Maj Pimenta\"], [\"aredes\", \"Maj Arêdes\"], [\"calderaro\", \"Cap Calderaro\"],\n  [\"cesse\", \"Cap Cesse\"], [\"dantas\", \"Cap Dantas\"], [\"loan\", \"Cap Loan\"], [\"santana\", \"Cap Santana\"],\n  [\"uerlei-moreira\", \"Cap Uerlei Moreira\"], [\"cavalcanti\", \"Cap Cavalcanti\"], [\"marcello\", \"Cap Marcello\"]\n].map(([id, nome]) => ({ id, nome }));\nconst NOME = Object.fromEntries(MILITARES.map(m => [m.id, m.nome]));\n\nconst CATS = [\n  { k: \"ferias26\", n: \"Férias 2026\" },\n  { k: \"feriasant\", n: \"Férias de ano anterior\" },\n  { k: \"natal\", n: \"Dispensa de Natal\", fixa: true },\n  { k: \"anonovo\", n: \"Dispensa de Ano-Novo\", fixa: true },\n  { k: \"instalacao\", n: \"Instalação\" },\n  { k: \"dispcmt\", n: \"Dispensa Cmt EsAO\" },\n  { k: \"curso\", n: \"Curso/estágio\" },\n  { k: \"missao\", n: \"Missão/serviço fora da EsAO\" },\n  { k: \"licenca\", n: \"Licença/afastamento já previsto\", tex: true },\n  { k: \"outro\", n: \"Outro afastamento autorizado\", tex: true }\n];\nconst CAT = Object.fromEntries(CATS.map(c => [c.k, c]));\n\nconst INI = \"2026-11-01\", FIM = \"2027-01-31\";\nconst DISP = {\n  natal:   { ini: \"2026-12-23\", fim: \"2026-12-28\", apres: \"2026-12-29\", n: \"Dispensa de Natal\" },\n  anonovo: { ini: \"2026-12-30\", fim: \"2027-01-04\", apres: \"2027-01-05\", n: \"Dispensa de Ano-Novo\" }\n};\nconst FERIADOS = {\n  \"2026-11-02\": \"Finados\", \"2026-11-15\": \"Proclamação da República\",\n  \"2026-11-20\": \"Dia Nacional de Zumbi e da Consciência Negra\", \"2026-12-25\": \"Natal\",\n  \"2027-01-01\": \"Confraternização Universal\"\n};\nconst MESES = [\n  { y: 2026, m: 10, n: \"Novembro\", c: \"Nov\" }, { y: 2026, m: 11, n: \"Dezembro\", c: \"Dez\" }, { y: 2027, m: 0, n: \"Janeiro\", c: \"Jan\" }\n];\nconst WD = [\"dom\", \"seg\", \"ter\", \"qua\", \"qui\", \"sex\", \"sáb\"];\nconst STEPS = [\"Nome\", \"Afastamentos\", \"Dispensa\", \"Desligamento\", \"Resumo\"];\n\n/* ======================= datas ======================= */\nconst dn = s => { const [y, m, d] = s.split(\"-\").map(Number); return Date.UTC(y, m - 1, d) / 864e5; };\nconst ds = n => new Date(n * 864e5).toISOString().slice(0, 10);\nconst add = (s, k) => ds(dn(s) + k);\nconst wd = s => new Date(dn(s) * 864e5).getUTCDay();\nconst f2 = s => s.slice(8, 10) + \"/\" + s.slice(5, 7);\nconst f3 = s => f2(s) + \"/\" + s.slice(0, 4);\nconst fw = s => f3(s) + \" (\" + WD[wd(s)] + \")\";\nconst fs = s => f2(s) + \" \" + WD[wd(s)];\nconst ndias = (a, b) => dn(b) - dn(a) + 1;\nconst ALL_DAYS = (() => { const r = []; for (let n = dn(INI); n <= dn(FIM); n++) r.push(ds(n)); return r; })();\nconst mesDias = (mi) => ALL_DAYS.filter(d => +d.slice(5, 7) - 1 === MESES[mi].m && +d.slice(0, 4) === MESES[mi].y);\nconst fmtHora = iso => { try { const d = new Date(iso); return d.toLocaleDateString(\"pt-BR\", { day: \"2-digit\", month: \"2-digit\" }) + \" às \" + d.toLocaleTimeString(\"pt-BR\", { hour: \"2-digit\", minute: \"2-digit\" }); } catch (e) { return \"\"; } };\nconst esc = s => String(s ?? \"\").replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\nconst uid = () => Math.random().toString(36).slice(2, 9);\nconst clone = o => JSON.parse(JSON.stringify(o));\nconst rangeTxt = (a, b) => a === b ? f3(a) + \" (\" + WD[wd(a)] + \") · 1 dia\" : fw(a) + \" a \" + fw(b) + \" · \" + ndias(a, b) + \" dias\";\n\n/* ======================= regras ======================= */\nconst valido = p => p && CAT[p.cat] && p.ini && p.fim && p.ini <= p.fim;\nconst sobrepoe = (a, b) => a.ini <= b.fim && b.ini <= a.fim;\nconst intersec = (a, b) => ({ ini: a.ini > b.ini ? a.ini : b.ini, fim: a.fim < b.fim ? a.fim : b.fim });\nconst intTxt = r => r.ini === r.fim ? f2(r.ini) : f2(r.ini) + \" a \" + f2(r.fim);\n\n/** Todos os afastamentos de uma resposta, incluindo a dispensa de fim de ano (datas fixas). */\nfunction afastamentos(rec) {\n  const out = (rec.periodos || []).map((p, i) => ({ ...p, idx: i + 1 }));\n  if (rec.dispensa === \"natal\" || rec.dispensa === \"anonovo\") {\n    const d = DISP[rec.dispensa];\n    out.push({ id: \"disp\", cat: rec.dispensa, ini: d.ini, fim: d.fim, fixa: true });\n  }\n  return out;\n}\n/** Dia de apresentação: o dia seguinte ao fim, desde que não emende com outro afastamento nem passe do desligamento. */\nfunction apresentacoes(rec) {\n  const ps = afastamentos(rec).filter(valido);\n  const res = [];\n  ps.forEach(p => {\n    const a = add(p.fim, 1);\n    if (ps.some(q => q !== p && q.ini <= a && a <= q.fim)) return;\n    if (rec.temDeslig && rec.deslig && a >= rec.deslig) return;\n    res.push({ dia: a, de: p });\n  });\n  return res;\n}\nconst nomeP = p => (CAT[p.cat] ? CAT[p.cat].n : \"Afastamento sem motivo\") + (p.ini && p.fim ? \" (\" + intTxt(p) + \")\" : \"\");\n\n/** Valida uma resposta. tipo: incompleto | conflito | aviso. step: passo do formulário onde se corrige. */\nfunction validar(rec) {\n  const out = [];\n  const push = (tipo, step, msg, pid, bloq) => out.push({ tipo, step, msg, pid, bloq: !!bloq });\n  (rec.periodos || []).forEach((p, i) => {\n    const r = \"Afastamento \" + (i + 1) + (CAT[p.cat] ? \" (\" + CAT[p.cat].n + \")\" : \"\");\n    if (!CAT[p.cat]) push(\"incompleto\", 1, r + \": escolha o motivo.\", p.id);\n    if (!p.ini || !p.fim) push(\"incompleto\", 1, r + \": marque \" + (!p.ini && !p.fim ? \"o início e o fim\" : !p.ini ? \"o início\" : \"o fim\") + \" no calendário.\", p.id);\n    else if (p.fim < p.ini) push(\"conflito\", 1, r + \": datas invertidas. O fim (\" + f3(p.fim) + \") é anterior ao início (\" + f3(p.ini) + \").\", p.id);\n    else if (p.ini < INI || p.fim > FIM) push(\"aviso\", 1, r + \": parte das datas está fora do período do levantamento (01/11/2026 a 31/01/2027).\", p.id);\n  });\n  if (!rec.dispensa) push(\"incompleto\", 2, \"Escolha a dispensa de fim de ano: Natal, Ano-Novo ou Sem dispensa.\");\n  if (rec.temDeslig !== true && rec.temDeslig !== false) push(\"incompleto\", 3, \"Informe se você tem data de desligamento no período.\");\n  else if (rec.temDeslig && !rec.deslig) push(\"incompleto\", 3, \"Marque no calendário a data de desligamento.\");\n\n  const outros = (rec.periodos || []).filter(valido);\n  if (rec.dispensa === \"natal\" || rec.dispensa === \"anonovo\") {\n    const outra = rec.dispensa === \"natal\" ? \"anonovo\" : \"natal\";\n    const w = DISP[outra];\n    outros.filter(p => sobrepoe(p, w)).forEach(p => {\n      push(\"conflito\", 2,\n        \"Você escolheu a \" + DISP[rec.dispensa].n + \", mas \" + nomeP(p) + \" alcança o período da \" + w.n +\n        \" (\" + intTxt(w) + \"). Para usufruir a \" + DISP[rec.dispensa].n + \", é preciso estar disponível durante todo o período de \" +\n        intTxt(w) + \". Ajuste as datas do afastamento ou escolha “Sem dispensa”.\", p.id);\n    });\n  }\n  const todos = afastamentos(rec).filter(valido);\n  for (let i = 0; i < todos.length; i++) for (let j = i + 1; j < todos.length; j++) {\n    const a = todos[i], b = todos[j];\n    if (sobrepoe(a, b)) push(\"conflito\", a.fixa || b.fixa ? 2 : 1,\n      nomeP(a) + \" e \" + nomeP(b) + \" se sobrepõem em \" + intTxt(intersec(a, b)) + \". Um mesmo dia não pode ter dois afastamentos: ajuste as datas.\", (a.fixa ? b : a).id);\n  }\n  if (rec.temDeslig && rec.deslig) {\n    todos.filter(p => p.fim >= rec.deslig).forEach(p => push(\"aviso\", p.fixa ? 2 : 1,\n      nomeP(p) + \" vai até \" + f3(p.fim) + \", mas o desligamento é em \" + f3(rec.deslig) + \". A partir do desligamento você deixa de contar no efetivo; confira as datas.\", p.id));\n  }\n  return out;\n}\nconst bloqueia = iss => iss.some(i => i.tipo === \"incompleto\" || i.bloq);\nconst temConflito = iss => iss.some(i => i.tipo === \"conflito\" || i.tipo === \"incompleto\");\n\n/* ======================= estado ======================= */\nconst S = {\n  view: \"form\", gestor: false, wantDash: false, docOf: {}, meu: null, trocaDe: null,\n  respostas: {},          // id -> registro salvo\n  ready: false,\n  backend: null,\n  // formulário\n  step: 0, mid: null, draft: null, baseRev: 0, editing: null, pickMonth: 1, pickStage: \"ini\", sending: false, sent: null, confirmConflito: false, staleRemote: null,\n  // painel\n  dMonth: 1, dSel: \"2026-12-23\", dMode: \"dia\", rIni: null, rFim: null, fMil: \"todos\", fCats: new Set(CATS.map(c => c.k)), mapScope: \"mes\", filtersOpen: false\n};\ntry { const h = (location.hash || \"\").replace(\"#\", \"\"); if (h === \"painel\") S.wantDash = true; } catch (e) {}\n\nfunction novoRegistro(id) {\n  return { id, militar: NOME[id], dispensa: null, temDeslig: null, deslig: null, periodos: [], rev: 0 };\n}\n\n/* ======================= base de dados ======================= */\nconst conn = (cls, txt) => { const el = document.getElementById(\"conn\"); el.className = \"conn \" + cls; el.querySelector(\"span\").textContent = txt; };\nfunction banner(html, cls) { const b = document.getElementById(\"banner\"); if (!html) { b.hidden = true; b.innerHTML = \"\"; return; } b.hidden = false; b.innerHTML = '<div class=\"' + (cls || \"\") + '\">' + html + \"</div>\"; }\n\n/* Várias respostas do mesmo militar (ex.: enviada pela conta dele e corrigida pelo gestor): vale a mais recente. */\nfunction setRespostas(list) {\n  const m = {}, docs = {};\n  list.forEach(r => {\n    if (!r || !NOME[r.id]) return;\n    if (!m[r.id] || (r.atualizadoEm || \"\") > (m[r.id].atualizadoEm || \"\")) { m[r.id] = r; docs[r.id] = r._doc || r.id; }\n  });\n  S.respostas = m; S.docOf = docs; S.ready = true;\n  if (S.mid && S.draft && m[S.mid] && (m[S.mid].rev || 0) !== S.baseRev && !S.sending && !S.sent) {\n    // Sem alterações locais: carrega a versão nova em silêncio. Com alterações: pergunta qual manter.\n    if (JSON.stringify(S.draft) === S.loaded && !S.editing) pickMilitar(S.mid); else S.staleRemote = m[S.mid];\n  }\n  render();\n}\n/* Gestor vê painel e todas as respostas; militar vê só o formulário e a própria resposta. */\nfunction setRole(gestor) {\n  S.gestor = !!gestor;\n  document.getElementById(\"views\").hidden = !S.gestor;\n  if (S.gestor && S.wantDash) S.view = \"dash\";\n  if (!S.gestor) S.view = \"form\";\n  render();\n}\nconst PRIV = \"Suas respostas ficam visíveis apenas para o Maj Modesto\";\nconst semDoc = r => { const o = clone(r); delete o._doc; return o; };\n\n/* Adaptador 1: base do Claude (artifact db). Regras de acesso: só o dono do artifact lê a coleção inteira;\n   cada militar lê e grava apenas o próprio documento respostas/<id da conta>. */\nasync function dbBackend(db, user) {\n  const col = db.collection(\"respostas\");\n  let gestor = false, uid = null;\n  try { gestor = user ? await user.isOwner() : false; } catch (e) {}\n  try { uid = user ? await user.id() : null; } catch (e) {}\n  setRole(gestor);\n  if (gestor) {\n    const listen = () => col.onSnapshot(snap => {\n      conn(\"on\", \"Painel do gestor · todas as respostas em tempo real\");\n      setRespostas(snap.docs.filter(d => d.exists).map(d => ({ ...d.data(), _doc: d.id })));\n    }, () => { conn(\"off\", \"Conexão interrompida. Recarregue a página.\"); setTimeout(listen, 3000); });\n    listen();\n  } else if (uid) {\n    const listen = () => col.doc(uid).onSnapshot(snap => {\n      conn(\"on\", \"Conectado · \" + PRIV);\n      S.meu = snap.exists ? snap.data() : null;\n      setRespostas(S.meu ? [{ ...S.meu, _doc: uid }] : []);\n    }, () => { conn(\"off\", \"Conexão interrompida. Recarregue a página.\"); setTimeout(listen, 3000); });\n    listen();\n  } else {\n    conn(\"off\", \"Conta não identificada\");\n    banner(\"<b>Entre na sua conta claude.ai</b> e abra o link novamente para enviar sua resposta.\", \"b\");\n    S.ready = true; render();\n  }\n  return {\n    kind: \"db\",\n    async save(rec, expectedRev) {\n      const ref = col.doc(gestor ? (S.docOf[rec.id] || rec.id) : uid);\n      let cur;\n      try { cur = await ref.get(); } catch (e) { if (e && e.code === \"unavailable\") { await new Promise(r => setTimeout(r, 600 + Math.random() * 600)); cur = await ref.get(); } else throw e; }\n      const curRev = cur.exists ? (cur.data().rev || 0) : 0;\n      if (curRev !== expectedRev) return { ok: false, conflict: true, current: cur.data() };\n      const now = new Date().toISOString();\n      const body = { ...semDoc(rec), rev: curRev + 1, atualizadoEm: now, enviadoEm: cur.exists ? (cur.data().enviadoEm || now) : now };\n      await ref.set(body);\n      return { ok: true, registro: body };\n    }\n  };\n}\n\n/* Adaptador 2: Google Apps Script + Planilha. Painel só com ?v=painel&chave=<chave do gestor>. */\nasync function gasBackend() {\n  const call = (fn, ...args) => new Promise((res, rej) => google.script.run.withSuccessHandler(res).withFailureHandler(rej)[fn](...args));\n  const loc = await new Promise(res => { try { google.script.url.getLocation(res); } catch (e) { res({ parameter: {} }); } });\n  const chave = (loc.parameter && loc.parameter.chave) || \"\";\n  if (loc.parameter && loc.parameter.v === \"painel\") S.wantDash = true;\n  let gestor = false;\n  const load = async () => {\n    try { setRespostas((await call(\"listar\", chave)) || []); conn(\"on\", \"Painel do gestor · planilha atualizada a cada 30 s\"); return true; }\n    catch (e) { return false; }\n  };\n  if (chave && await load()) {\n    gestor = true; setRole(true);\n    setInterval(() => { if (!document.hidden) load(); }, 30000);\n    document.addEventListener(\"visibilitychange\", () => { if (!document.hidden) load(); });\n  } else {\n    if (chave) banner(\"<b>Chave do painel inválida.</b> Abrindo só o formulário.\", \"w\");\n    setRole(false); conn(\"on\", \"Conectado · \" + PRIV); S.ready = true; render();\n  }\n  return {\n    kind: \"gas\",\n    async loadOne(id) {\n      if (gestor) return;\n      try { const r = await call(\"carregar\", id); if (r) S.respostas[id] = r; else delete S.respostas[id]; } catch (e) {}\n    },\n    async save(rec, expectedRev) {\n      const r = await call(\"salvar\", JSON.stringify(semDoc(rec)), expectedRev);\n      if (r && r.ok) S.respostas[rec.id] = r.registro;\n      return r;\n    }\n  };\n}\n\n/* Adaptador 3: demonstração local (arquivo aberto fora da hospedagem). Os dados ficam só neste navegador. */\nfunction localBackend() {\n  const KEY = \"afast-esao-demo\";\n  const read = () => { try { return JSON.parse(localStorage.getItem(KEY) || \"{}\"); } catch (e) { return {}; } };\n  const write = o => { try { localStorage.setItem(KEY, JSON.stringify(o)); } catch (e) {} };\n  setRole(true);\n  setRespostas(Object.values(read()));\n  window.addEventListener(\"storage\", e => { if (e.key === KEY) setRespostas(Object.values(read())); });\n  conn(\"\", \"Modo demonstração · os dados ficam só neste aparelho\");\n  banner(\"<b>Modo demonstração.</b> Esta cópia não está ligada a uma base compartilhada: as respostas ficam salvas apenas neste navegador.\", \"w\");\n  return {\n    kind: \"local\",\n    async save(rec, expectedRev) {\n      const all = read(); const cur = all[rec.id]; const curRev = cur ? cur.rev || 0 : 0;\n      if (curRev !== expectedRev) return { ok: false, conflict: true, current: cur };\n      const now = new Date().toISOString();\n      const body = { ...semDoc(rec), rev: curRev + 1, atualizadoEm: now, enviadoEm: cur ? (cur.enviadoEm || now) : now };\n      all[rec.id] = body; write(all); setRespostas(Object.values(all));\n      return { ok: true, registro: body };\n    }\n  };\n}\n\nasync function initBackend() {\n  if (window.google && google.script && google.script.run) { S.backend = await gasBackend(); return; }\n  if (window.claude && typeof window.claude.use === \"function\") {\n    let db = null, user = null;\n    try { [db, user] = await Promise.all([window.claude.use(\"db\"), window.claude.use(\"user\")]); } catch (e) {}\n    if (db) { S.backend = await dbBackend(db, user); checkWrite(user); return; }\n    setRole(false);\n    conn(\"off\", \"Base indisponível\");\n    banner(\"<b>Não foi possível abrir a base de respostas.</b> Entre na sua conta claude.ai e abra o link novamente. Sem a base, a resposta não pode ser enviada.\", \"b\");\n    S.ready = true; S.backend = null; render(); return;\n  }\n  S.backend = localBackend();\n}\nasync function checkWrite(user) {\n  try {\n    if (user && typeof user.can === \"function\" && await user.can(\"data.write\") === false)\n      banner(\"<b>Seu acesso é somente leitura.</b> Você não consegue enviar respostas. Peça ao Maj Modesto para compartilhar o link com você com permissão de edição.\", \"w\");\n  } catch (e) {}\n}\n\n/* ======================= render ======================= */\nconst app = document.getElementById(\"app\");\nfunction render() {\n  document.getElementById(\"v-form\").setAttribute(\"aria-pressed\", S.view === \"form\");\n  document.getElementById(\"v-dash\").setAttribute(\"aria-pressed\", S.view === \"dash\");\n  app.innerHTML = S.view === \"form\" ? renderForm() : renderDash();\n}\nconst sw = k => '<i class=\"sw' + (CAT[k] && CAT[k].tex ? \" tex\" : \"\") + '\" style=\"--c:var(--c-' + k + ')\" aria-hidden=\"true\"></i>';\nfunction statusDe(id) {\n  const r = S.respostas[id];\n  if (!r) return { k: \"pend\", t: \"Pendente\" };\n  const iss = validar(r);\n  if (temConflito(iss)) return { k: \"bad\", t: \"Precisa corrigir\", iss };\n  return { k: \"ok\", t: \"Respondido\", iss };\n}\nconst pill = st => '<span class=\"pill ' + st.k + '\">' + (st.k === \"ok\" ? \"✓ \" : st.k === \"bad\" ? \"! \" : \"○ \") + st.t + \"</span>\";\n\n/* ---------- formulário ---------- */\nfunction renderForm() {\n  if (S.sent) return renderSent();\n  const stepsHtml = '<nav class=\"steps\" aria-label=\"Etapas\">' + STEPS.map((s, i) =>\n    '<button data-act=\"step\" data-i=\"' + i + '\" class=\"' + (i === S.step ? \"on\" : i < S.step ? \"done\" : \"\") + '\" ' + (!S.mid && i > 0 ? \"disabled\" : \"\") +\n    ' aria-current=\"' + (i === S.step ? \"step\" : \"false\") + '\"><span class=\"bar\"></span><span class=\"lbl\">' + (i + 1) + \". \" + s + \"</span></button>\").join(\"\") + \"</nav>\";\n  let body = \"\";\n  if (S.staleRemote) body += '<div class=\"issue aviso\" style=\"margin-bottom:14px\"><span class=\"ic\">!</span><div>Esta resposta foi alterada em outro aparelho (' + esc(fmtHora(S.staleRemote.atualizadoEm)) + ').<div class=\"go\" style=\"display:flex;gap:6px;flex-wrap:wrap\"><button class=\"btn sm pri\" data-act=\"loadRemote\">Carregar a versão mais recente</button><button class=\"btn sm\" data-act=\"keepMine\">Manter o que estou editando</button></div></div></div>';\n  if (S.editing) body += renderEditor();\n  else body += [step0, step1, step2, step3, step4][S.step]();\n  const nav = S.editing ? \"\" : '<div class=\"navbar\"><div class=\"navbar-in\">' +\n    (S.step > 0 ? '<button class=\"btn\" data-act=\"prev\">Voltar</button>' : \"\") +\n    (S.step < 4 ? '<button class=\"btn pri\" data-act=\"next\" ' + (!S.mid ? \"disabled\" : \"\") + \">\" + (S.step === 0 ? \"Começar\" : \"Avançar\") + \"</button>\" : \"\") +\n    (S.step === 4 ? sendButton() : \"\") + \"</div></div>\";\n  return '<div class=\"form-wrap\">' + stepsHtml + body + \"</div>\" + nav;\n}\nfunction issuesHtml(list, withGo) {\n  if (!list.length) return \"\";\n  return '<div class=\"issues\" role=\"status\">' + list.map(i =>\n    '<div class=\"issue ' + i.tipo + '\"><span class=\"ic\" aria-hidden=\"true\">' + (i.tipo === \"aviso\" ? \"!\" : \"✕\") + '</span><div><b>' +\n    (i.tipo === \"conflito\" ? \"Conflito: \" : i.tipo === \"incompleto\" ? \"Falta preencher: \" : \"Atenção: \") + \"</b>\" + esc(i.msg) +\n    (withGo && i.step !== S.step ? '<div class=\"go\"><button class=\"btn sm\" data-act=\"step\" data-i=\"' + i.step + '\">Corrigir em “' + STEPS[i.step] + \"”</button></div>\" : \"\") +\n    \"</div></div>\").join(\"\") + \"</div>\";\n}\nfunction step0() {\n  return '<h2 class=\"q\">Quem é você?</h2><p class=\"hint\">Escolha seu nome. Se já respondeu, sua resposta é carregada para você revisar e corrigir.' + (S.gestor ? \"\" : \" \" + PRIV + \".\") + '</p>' +\n    '<div class=\"names\">' + MILITARES.map(m => {\n      const st = statusDe(m.id);\n      const tag = S.gestor ? (S.ready ? pill(st) : \"\") : (S.respostas[m.id] ? '<span class=\"pill ok\">✓ Sua resposta</span>' : \"\");\n      return '<button class=\"name-btn\" data-act=\"pick\" data-id=\"' + m.id + '\" aria-pressed=\"' + (S.mid === m.id) + '\"><strong>' + esc(m.nome) + \"</strong>\" + tag + \"</button>\";\n    }).join(\"\") + \"</div>\" +\n    (S.trocaDe && S.mid ? '<div class=\"issue aviso\" style=\"margin-top:14px\"><span class=\"ic\">!</span><div>Esta conta já enviou a resposta de <b>' + esc(NOME[S.trocaDe]) + \"</b>. Se enviar como \" + esc(NOME[S.mid]) + \", aquela resposta será substituída.</div></div>\" : \"\") +\n    (S.mid && S.respostas[S.mid] ? '<div class=\"issue okay\" style=\"margin-top:14px\"><span class=\"ic\">✓</span><div>Resposta de <b>' + esc(NOME[S.mid]) + \"</b> enviada em \" + esc(fmtHora(S.respostas[S.mid].atualizadoEm)) + \" está carregada. Avance para revisar e corrigir o que precisar.</div></div>\" : \"\");\n}\nfunction perCard(p, i) {\n  const fix = p.fixa;\n  return '<div class=\"card per\"><span class=\"stripe\" style=\"--c:var(--c-' + p.cat + ')\"></span><div style=\"min-width:0\"><h3>' + esc(CAT[p.cat] ? CAT[p.cat].n : \"Motivo não escolhido\") + \"</h3>\" +\n    \"<p>\" + (p.ini && p.fim ? esc(rangeTxt(p.ini, p.fim)) : \"Datas não marcadas\") + \"</p>\" +\n    (p.obs ? \"<p>Obs.: \" + esc(p.obs) + \"</p>\" : \"\") +\n    (fix ? '<p class=\"lock\">Datas fixas · escolhida no passo “Dispensa”</p>' : \"\") + \"</div>\" +\n    '<div class=\"acts\">' + (fix ? '<button class=\"btn sm\" data-act=\"step\" data-i=\"2\">Alterar</button>' :\n      '<button class=\"btn sm\" data-act=\"edit\" data-pid=\"' + p.id + '\">Editar</button><button class=\"btn sm danger\" data-act=\"del\" data-pid=\"' + p.id + '\" aria-label=\"Remover afastamento ' + (i + 1) + '\">Remover</button>') + \"</div></div>\";\n}\nfunction step1() {\n  const r = S.draft;\n  const list = afastamentos(r).sort((a, b) => (a.ini || \"9\") < (b.ini || \"9\") ? -1 : 1);\n  return '<h2 class=\"q\">Seus afastamentos</h2><p class=\"hint\">Inclua férias, cursos, missões e outros afastamentos entre 01/11/2026 e 31/01/2027. Pode adicionar quantos períodos precisar, inclusive do mesmo tipo.</p>' +\n    '<div class=\"stack\">' + (list.length ? list.map(perCard).join(\"\") : '<p class=\"empty\">Nenhum afastamento registrado. Se não houver nenhum além da dispensa de fim de ano, toque em Avançar.</p>') +\n    '<button class=\"add\" data-act=\"new\">+ ' + (list.length ? \"Adicionar outro afastamento\" : \"Adicionar afastamento\") + \"</button></div>\" +\n    issuesHtml(validar(r).filter(i => i.step === 1), true);\n}\nfunction dispOpt(k, titulo, sub) {\n  const r = S.draft;\n  const test = clone(r); test.dispensa = k;\n  const conf = k !== \"sem\" ? validar(test).filter(i => i.step === 2 && i.tipo === \"conflito\") : [];\n  return '<button class=\"opt\" role=\"radio\" data-act=\"disp\" data-k=\"' + k + '\" aria-checked=\"' + (r.dispensa === k) + '\"><span class=\"radio\"></span><strong>' + titulo + \"</strong><small>\" + sub + \"</small>\" +\n    (conf.length && r.dispensa !== k ? '<span class=\"extra\"><span class=\"pill bad\">! Gera conflito com seus afastamentos</span></span>' : \"\") + \"</button>\";\n}\nfunction step2() {\n  const r = S.draft;\n  const all = afastamentos(r).filter(p => valido(p) && !p.fixa);\n  const cobreN = all.some(p => sobrepoe(p, DISP.natal)), cobreA = all.some(p => sobrepoe(p, DISP.anonovo));\n  let dica = \"\";\n  if (cobreN && cobreA) dica = \"Seus afastamentos já alcançam os dois períodos. Escolha “Sem dispensa”.\";\n  else if (cobreN) dica = \"Você tem afastamento entre 23 e 28/12. Por isso não pode usufruir a Dispensa de Ano-Novo.\";\n  else if (cobreA) dica = \"Você tem afastamento entre 30/12 e 04/01. Por isso não pode usufruir a Dispensa de Natal.\";\n  return '<h2 class=\"q\">Dispensa de fim de ano</h2><p class=\"hint\">As datas são fixas e entram automaticamente.</p>' +\n    '<div class=\"rule\"><strong>Regra</strong>Para usufruir uma das dispensas, você precisa estar disponível para o trabalho durante todo o período da outra. Quem estiver de férias nos dois períodos escolhe “Sem dispensa”.</div>' +\n    '<div class=\"opts\" role=\"radiogroup\" aria-label=\"Dispensa de fim de ano\">' +\n    dispOpt(\"natal\", \"Dispensa de Natal\", \"23 a 28/12/2026 · apresentação em 29/12/2026 (ter)<br>Exige estar disponível de 30/12 a 04/01.\") +\n    dispOpt(\"anonovo\", \"Dispensa de Ano-Novo\", \"30/12/2026 a 04/01/2027 · apresentação em 05/01/2027 (ter)<br>Exige estar disponível de 23 a 28/12.\") +\n    dispOpt(\"sem\", \"Sem dispensa\", \"Não usufruirá nenhuma das duas. Férias e demais afastamentos seguem normalmente.\") + \"</div>\" +\n    (dica ? '<div class=\"issue aviso\" style=\"margin-top:14px\"><span class=\"ic\">i</span><div>' + dica + \"</div></div>\" : \"\") +\n    issuesHtml(validar(r).filter(i => i.step === 2), true);\n}\nfunction step3() {\n  const r = S.draft;\n  return '<h2 class=\"q\">Desligamento</h2><p class=\"hint\">Se você for desligado do curso no período, informe a data. A partir dela você deixa de contar no efetivo.</p>' +\n    '<div class=\"opts\" role=\"radiogroup\" aria-label=\"Desligamento\">' +\n    '<button class=\"opt\" role=\"radio\" data-act=\"tdes\" data-v=\"0\" aria-checked=\"' + (r.temDeslig === false) + '\"><span class=\"radio\"></span><strong>Não tenho desligamento</strong><small>Até 31/01/2027</small></button>' +\n    '<button class=\"opt\" role=\"radio\" data-act=\"tdes\" data-v=\"1\" aria-checked=\"' + (r.temDeslig === true) + '\"><span class=\"radio\"></span><strong>Tenho data de desligamento</strong><small>' + (r.deslig ? \"Desligamento em \" + esc(fw(r.deslig)) : \"Marque a data no calendário\") + \"</small></button></div>\" +\n    (r.temDeslig ? '<div class=\"card\" style=\"margin-top:12px\">' + pickCal(\"deslig\") + \"</div>\" : \"\") +\n    issuesHtml(validar(r).filter(i => i.step === 3), true);\n}\nfunction personStrip(r) {\n  const ps = afastamentos(r).filter(valido);\n  return '<div class=\"strip\" aria-hidden=\"true\">' + MESES.map((M, mi) => {\n    const dias = mesDias(mi), a = dias[0], b = dias[dias.length - 1], tot = dias.length;\n    const bars = ps.filter(p => p.ini <= b && p.fim >= a).map(p => {\n      const s = p.ini < a ? a : p.ini, e = p.fim > b ? b : p.fim;\n      return '<b style=\"--c:var(--c-' + p.cat + ');left:' + ((dn(s) - dn(a)) / tot * 100) + \"%;width:\" + (ndias(s, e) / tot * 100) + '%\"></b>';\n    }).join(\"\");\n    let gone = \"\";\n    if (r.temDeslig && r.deslig && r.deslig <= b) { const s = r.deslig < a ? a : r.deslig; gone = '<span class=\"gone\" style=\"left:' + ((dn(s) - dn(a)) / tot * 100) + '%\"></span>'; }\n    return '<div class=\"m\"><span>' + M.c + '</span><div class=\"t\">' + bars + gone + \"</div></div>\";\n  }).join(\"\") + \"</div>\";\n}\nfunction resumoLista(r) {\n  const ps = afastamentos(r).filter(p => p.ini && p.fim).sort((a, b) => a.ini < b.ini ? -1 : 1);\n  const ap = apresentacoes(r);\n  const rows = ps.map(p => {\n    const a = ap.find(x => x.de.id === p.id);\n    return '<li><strong>' + sw(p.cat) + \" \" + esc(CAT[p.cat] ? CAT[p.cat].n : \"Motivo não escolhido\") + \"</strong><span class=\\\"why\\\"><span>\" + esc(rangeTxt(p.ini, p.fim)) + \"</span>\" +\n      (a ? \"<span>Apresentação: \" + esc(fw(a.dia)) + \"</span>\" : \"\") + (p.obs ? \"<span>Obs.: \" + esc(p.obs) + \"</span>\" : \"\") + \"</span></li>\";\n  });\n  rows.push(\"<li><strong>Dispensa de fim de ano</strong><span class=\\\"why\\\"><span>\" + (r.dispensa === \"sem\" ? \"Sem dispensa\" : r.dispensa ? DISP[r.dispensa].n : \"Não escolhida\") + \"</span></span></li>\");\n  rows.push(\"<li><strong>Desligamento</strong><span class=\\\"why\\\"><span>\" + (r.temDeslig === true ? (r.deslig ? esc(fw(r.deslig)) : \"Data não marcada\") : r.temDeslig === false ? \"Sem desligamento no período\" : \"Não informado\") + \"</span></span></li>\");\n  return '<ul class=\"who\" style=\"margin-top:12px\">' + rows.join(\"\") + \"</ul>\";\n}\nfunction step4() {\n  const r = S.draft, iss = validar(r);\n  const ok = !iss.length;\n  return '<h2 class=\"q\">Confira e envie</h2><p class=\"hint\">' + esc(NOME[S.mid]) + \" · \" + (S.baseRev ? \"você está corrigindo uma resposta já enviada.\" : \"primeiro envio.\") + \"</p>\" +\n    '<div class=\"card\">' + personStrip(r) + resumoLista(r) + \"</div>\" +\n    (ok ? '<div class=\"issues\"><div class=\"issue okay\"><span class=\"ic\">✓</span><div><b>Tudo certo.</b> Nenhum conflito encontrado.</div></div></div>' : issuesHtml(iss, true)) +\n    (S.confirmConflito ? '<div class=\"issue conflito\" style=\"margin-top:12px\"><span class=\"ic\">!</span><div>Há conflitos não resolvidos. Se enviar assim, sua resposta ficará marcada como <b>Precisa corrigir</b>' + (S.gestor ? \" no painel\" : \" para o Maj Modesto\") + '. Toque de novo em “Enviar mesmo assim” para confirmar.</div></div>' : \"\");\n}\nfunction sendButton() {\n  const iss = validar(S.draft);\n  if (!S.backend) return '<button class=\"btn pri\" disabled>Base indisponível</button>';\n  if (S.sending) return '<button class=\"btn pri\" disabled>Enviando…</button>';\n  if (bloqueia(iss)) return '<button class=\"btn pri\" disabled>Corrija os itens acima</button>';\n  if (temConflito(iss)) return '<button class=\"btn pri\" data-act=\"send\" style=\"background:var(--bad);border-color:var(--bad)\">Enviar mesmo assim</button>';\n  return '<button class=\"btn pri\" data-act=\"send\">' + (S.baseRev ? \"Enviar correção\" : \"Enviar resposta\") + \"</button>\";\n}\nfunction renderSent() {\n  const r = S.respostas[S.sent] || S.draft, st = statusDe(S.sent);\n  return '<div class=\"form-wrap done-screen\"><p class=\"big-ok\">' + (st.k === \"ok\" ? \"Resposta registrada\" : \"Resposta registrada com pendências\") + '</p><p class=\"hint\" style=\"margin-top:8px\">' + esc(NOME[S.sent]) + \" · \" + esc(fmtHora(r.atualizadoEm)) + \". Para corrigir depois, abra o mesmo link e escolha seu nome.</p>\" +\n    '<div class=\"card\">' + personStrip(r) + resumoLista(r) + \"</div>\" +\n    (st.k === \"bad\" ? issuesHtml(st.iss.filter(i => i.tipo !== \"aviso\"), false) : \"\") +\n    '<div style=\"display:grid;gap:8px;margin-top:16px\"><button class=\"btn big pri\" data-act=\"reedit\">Corrigir esta resposta</button>' + (S.gestor ? '<button class=\"btn big\" data-act=\"restart\">Preencher para outro militar</button>' : \"\") + '</div></div>';\n}\n\n/* editor de período */\nfunction renderEditor() {\n  const e = S.editing;\n  const cats = CATS.map(c => '<button class=\"cat-btn\" role=\"radio\" data-act=\"ecat\" data-k=\"' + c.k + '\" aria-checked=\"' + (e.cat === c.k) + '\">' + sw(c.k) + \"<span>\" + c.n +\n    (c.fixa ? \"<small>\" + (c.k === \"natal\" ? \"23 a 28/12 · datas fixas\" : \"30/12 a 04/01 · datas fixas\") + \"</small>\" : \"\") + \"</span></button>\").join(\"\");\n  const fixa = e.cat && CAT[e.cat].fixa;\n  const ok = e.cat && (fixa || (e.ini && e.fim));\n  let missing = [];\n  if (!e.cat) missing.push(\"o motivo\");\n  if (!fixa && !e.ini) missing.push(\"o início\");\n  if (!fixa && e.ini && !e.fim) missing.push(\"o fim\");\n  // conflitos do período sendo editado com os demais\n  const test = clone(S.draft);\n  if (!fixa && e.cat && e.ini && e.fim) {\n    const p = { id: e.id, cat: e.cat, ini: e.ini, fim: e.fim, obs: e.obs };\n    const i = test.periodos.findIndex(x => x.id === e.id); if (i >= 0) test.periodos[i] = p; else test.periodos.push(p);\n  }\n  const live = (!fixa && e.ini && e.fim) ? validar(test).filter(x => x.pid === e.id && x.tipo !== \"incompleto\") : [];\n  return '<h2 class=\"q\">' + (e.isNew ? \"Novo afastamento\" : \"Editar afastamento\") + '</h2>' +\n    '<p class=\"lab\" style=\"margin:14px 0 8px\">1. Motivo</p><div class=\"cats\" role=\"radiogroup\" aria-label=\"Motivo\">' + cats + \"</div>\" +\n    (fixa ? '<div class=\"rule\" style=\"margin-top:14px\"><strong>' + CAT[e.cat].n + \"</strong>Datas fixas: \" + (e.cat === \"natal\" ? \"23 a 28/12/2026, apresentação em 29/12/2026.\" : \"30/12/2026 a 04/01/2027, apresentação em 05/01/2027.\") + \" A escolha fica registrada no passo “Dispensa”.</div>\" :\n      '<p class=\"lab\" style=\"margin:18px 0 0\">2. Início e fim</p><p class=\"hint\" style=\"margin:2px 0 0\">Toque no primeiro dia e depois no último dia. Datas inclusivas.</p>' + pickCal(\"range\") +\n      '<div class=\"field\"><label for=\"obs\">Observação (opcional)</label><input type=\"text\" id=\"obs\" maxlength=\"120\" placeholder=\"Ex.: local do curso, nº do documento\" value=\"' + esc(e.obs || \"\") + '\"></div>') +\n    issuesHtml(live, false) +\n    '<div style=\"display:grid;grid-template-columns:1fr 2fr;gap:8px;margin-top:18px\"><button class=\"btn big\" data-act=\"ecancel\">Cancelar</button><button class=\"btn big pri\" data-act=\"esave\" ' + (ok ? \"\" : \"disabled\") + \">\" +\n    (ok ? (fixa ? \"Registrar dispensa\" : \"Salvar afastamento\") : \"Falta \" + missing.join(\" e \")) + \"</button></div>\";\n}\n/* calendário de seleção (intervalo do editor ou data de desligamento) */\nfunction pickCal(mode) {\n  const mi = S.pickMonth, dias = mesDias(mi), e = S.editing, r = S.draft;\n  const others = afastamentos(r).filter(p => valido(p) && (!e || p.id !== e.id));\n  const pad = wd(dias[0]);\n  let cells = \"\";\n  for (let i = 0; i < pad; i++) cells += '<span class=\"day blank\"></span>';\n  dias.forEach(d => {\n    let cls = \"day\" + (wd(d) === 0 || wd(d) === 6 ? \" we\" : \"\") + (FERIADOS[d] ? \" fer\" : \"\");\n    let lbl = fw(d) + (FERIADOS[d] ? \", feriado: \" + FERIADOS[d] : \"\");\n    if (mode === \"range\") {\n      if (e.ini && e.fim && d > e.ini && d < e.fim) cls += \" in\";\n      if (d === e.ini || d === e.fim) cls += \" edge\";\n    } else if (r.deslig === d) cls += \" edge\";\n    const occ = others.filter(p => p.ini <= d && d <= p.fim);\n    if (occ.length) lbl += \", já ocupado por \" + occ.map(p => CAT[p.cat].n).join(\" e \");\n    cells += '<button class=\"' + cls + '\" data-act=\"' + (mode === \"range\" ? \"pday\" : \"dday\") + '\" data-d=\"' + d + '\" aria-label=\"' + esc(lbl) + '\"' + (mode === \"range\" && (d === e.ini || d === e.fim) ? ' aria-pressed=\"true\"' : \"\") + '><span class=\"dn\">' + (+d.slice(8)) + \"</span>\" +\n      (occ.length ? '<span class=\"marks\">' + occ.map(p => '<i style=\"--c:var(--c-' + p.cat + ')\"></i>').join(\"\") + \"</span>\" : \"\") + \"</button>\";\n  });\n  const sum = mode === \"range\" ? '<div class=\"picksum\"><div class=\"' + (S.pickStage === \"ini\" ? \"cur\" : \"\") + '\">Início<b>' + (e.ini ? esc(fw(e.ini)) : \"toque no dia\") + '</b></div><div class=\"' + (S.pickStage === \"fim\" ? \"cur\" : \"\") + '\">Fim<b>' + (e.fim ? esc(fw(e.fim)) : e.ini ? \"toque no último dia\" : \"—\") + \"</b></div></div>\" +\n    (e.ini && e.fim ? '<p class=\"hint\" style=\"margin:8px 0 0\">' + ndias(e.ini, e.fim) + \" dias · apresentação prevista em \" + esc(fw(add(e.fim, 1))) + \"</p>\" : \"\") : \"\";\n  const leg = others.length ? '<div class=\"legend\">' + [...new Set(others.map(p => p.cat))].map(k => \"<span>\" + sw(k) + \" já ocupado: \" + CAT[k].n + \"</span>\").join(\"\") + \"<span><u>sublinhado</u> = feriado nacional</span></div>\" : '<div class=\"legend\"><span><u>sublinhado</u> = feriado nacional</span></div>';\n  return '<div class=\"cal\"><div class=\"mtabs\" role=\"group\" aria-label=\"Mês\">' + MESES.map((M, i) => '<button data-act=\"pmonth\" data-i=\"' + i + '\" aria-pressed=\"' + (i === mi) + '\">' + M.n + (i === 2 ? \" 27\" : \"\") + \"</button>\").join(\"\") + \"</div>\" +\n    '<div class=\"wk\" aria-hidden=\"true\">' + WD.map(w => \"<span>\" + w + \"</span>\").join(\"\") + '</div><div class=\"grid\">' + cells + \"</div>\" + leg + sum + \"</div>\";\n}\n\n/* ---------- painel ---------- */\n/** Situação de um militar num dia. Nunca conta ninguém duas vezes: retorna um único estado por pessoa. */\nfunction situacao(id, d) {\n  const r = S.respostas[id];\n  if (!r) return { k: \"pend\" };\n  if (r.temDeslig && r.deslig && d >= r.deslig) return { k: \"desl\" };\n  const ps = afastamentos(r).filter(p => valido(p) && p.ini <= d && d <= p.fim);\n  const ap = apresentacoes(r).filter(a => a.dia === d);\n  if (ps.length) return { k: \"fora\", ps };\n  return { k: \"disp\", apres: ap };\n}\nconst milsFiltro = () => MILITARES.filter(m => S.fMil === \"todos\" || S.fMil === m.id);\nconst catOn = k => S.fCats.has(k);\nconst filtroCatAtivo = () => S.fCats.size !== CATS.length;\nfunction contDia(d) {\n  const c = { efetivo: 0, disp: 0, fora: 0, foraF: 0, pend: 0, desl: 0, cats: new Set(), apr: 0, dsl: 0 };\n  milsFiltro().forEach(m => {\n    const s = situacao(m.id, d);\n    if (s.k === \"desl\") { c.desl++; const r = S.respostas[m.id]; if (r.deslig === d) c.dsl++; return; }\n    c.efetivo++;\n    if (s.k === \"pend\") c.pend++;\n    else if (s.k === \"fora\") { c.fora++; const fp = s.ps.filter(p => catOn(p.cat)); if (fp.length) { c.foraF++; fp.forEach(p => c.cats.add(p.cat)); } }\n    else { c.disp++; if (s.apres.length) c.apr++; }\n  });\n  return c;\n}\nfunction renderDash() {\n  if (!S.ready) return '<div class=\"dash\"><p class=\"empty\">Carregando respostas…</p></div>';\n  const st = MILITARES.map(m => ({ m, s: statusDe(m.id) }));\n  const nOk = st.filter(x => x.s.k === \"ok\").length, nBad = st.filter(x => x.s.k === \"bad\").length, nPend = st.filter(x => x.s.k === \"pend\").length;\n  const kpis = '<div class=\"kpis full\">' +\n    '<div class=\"kpi\"><div class=\"v num\">13</div><div class=\"l\">Efetivo do curso</div></div>' +\n    '<div class=\"kpi ok\"><a href=\"#status\" class=\"kpi-a\" style=\"color:inherit;text-decoration:none\"><div class=\"v num\">' + nOk + '</div><div class=\"l\">✓ Respondidos sem pendência</div></a></div>' +\n    '<div class=\"kpi bad\"><a href=\"#status\" style=\"color:inherit;text-decoration:none\"><div class=\"v num\">' + nBad + '</div><div class=\"l\">! Precisam corrigir</div></a></div>' +\n    '<div class=\"kpi pend\"><a href=\"#status\" style=\"color:inherit;text-decoration:none\"><div class=\"v num\">' + nPend + '</div><div class=\"l\">○ Pendentes (sem resposta)</div></a></div></div>';\n  return '<div class=\"dash\">' + kpis + renderFilters() + renderCalendar() + renderDetail() + renderMap() + renderStatus(st) + renderDates() + \"</div>\";\n}\nfunction renderFilters() {\n  const resumo = (S.fMil === \"todos\" ? \"todos os militares\" : NOME[S.fMil]) + \" · \" + (filtroCatAtivo() ? S.fCats.size + \" de \" + CATS.length + \" tipos\" : \"todos os tipos\");\n  return '<details class=\"sec full\" id=\"filtros\"' + (S.filtersOpen ? \" open\" : \"\") + '><summary class=\"lab\" style=\"cursor:pointer\">Filtros <span class=\"hint\" style=\"font-weight:400\">· ' + esc(resumo) + '</span></summary><div class=\"filters\" style=\"margin-top:10px\">' +\n    '<div style=\"display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:end\"><div><label class=\"lab\" for=\"fmil\">Militar</label><select id=\"fmil\" data-act=\"fmil\" style=\"margin-top:4px\"><option value=\"todos\">Todos os 13 militares</option>' +\n    MILITARES.map(m => '<option value=\"' + m.id + '\"' + (S.fMil === m.id ? \" selected\" : \"\") + \">\" + esc(m.nome) + \"</option>\").join(\"\") + \"</select></div>\" +\n    (filtroCatAtivo() || S.fMil !== \"todos\" ? '<button class=\"btn sm\" data-act=\"fclear\">Limpar filtros</button>' : \"\") + \"</div>\" +\n    '<div><span class=\"lab\">Tipo de afastamento</span> <span class=\"hint\" style=\"font-size:12px\">· toque para ligar ou desligar</span><div class=\"chips\" style=\"margin-top:6px\">' +\n    CATS.map(c => '<button class=\"chip\" data-act=\"fcat\" data-k=\"' + c.k + '\" aria-pressed=\"' + catOn(c.k) + '\"><span class=\"chk\" aria-hidden=\"true\">' + (catOn(c.k) ? \"✓\" : \"\") + \"</span>\" + sw(c.k) + esc(c.n) + \"</button>\").join(\"\") +\n    '<button class=\"chip\" data-act=\"fall\">' + (filtroCatAtivo() ? \"Marcar todos\" : \"Desmarcar todos\") + \"</button></div></div></div></details>\";\n}\nfunction renderCalendar() {\n  const mi = S.dMonth, dias = mesDias(mi), pad = wd(dias[0]);\n  let cells = \"\";\n  for (let i = 0; i < pad; i++) cells += '<span class=\"day blank\"></span>';\n  const maxFora = Math.max(1, ...ALL_DAYS.map(d => contDia(d).foraF));\n  const inR = d => S.dMode === \"intervalo\" && S.rIni && (S.rFim ? d >= S.rIni && d <= S.rFim : d === S.rIni);\n  dias.forEach(d => {\n    const c = contDia(d);\n    const h = c.foraF ? Math.round(14 + c.foraF / maxFora * 64) : 0;\n    const hot = h >= 45;\n    const flags = (c.apr ? \"▲\" + c.apr : \"\") + (c.dsl ? \" ✕\" + c.dsl : \"\");\n    const lbl = fw(d) + \": \" + c.foraF + \" afastado\" + (c.foraF === 1 ? \"\" : \"s\") + (filtroCatAtivo() ? \" (tipos filtrados)\" : \"\") + \", \" + c.disp + \" disponíve\" + (c.disp === 1 ? \"l\" : \"is\") + \", \" + c.pend + \" sem resposta\" + (c.apr ? \", \" + c.apr + \" apresentação\" : \"\") + (c.dsl ? \", \" + c.dsl + \" desligamento\" : \"\") + (FERIADOS[d] ? \", feriado: \" + FERIADOS[d] : \"\");\n    cells += '<button class=\"day' + (wd(d) === 0 || wd(d) === 6 ? \" we\" : \"\") + (FERIADOS[d] ? \" fer\" : \"\") + (hot ? \" hot\" : \"\") + (S.dMode === \"dia\" && S.dSel === d ? \" sel\" : \"\") + (inR(d) ? \" rng\" : \"\") +\n      '\" style=\"--h:' + h + '%\" data-act=\"dsel\" data-d=\"' + d + '\" aria-label=\"' + esc(lbl) + '\"><span class=\"dn\">' + (+d.slice(8)) + \"</span>\" +\n      (flags ? '<span class=\"flags\" aria-hidden=\"true\">' + flags + \"</span>\" : \"\") +\n      '<span class=\"cnt\" aria-hidden=\"true\"><b class=\"num\">' + c.foraF + \"</b>fora</span>\" +\n      '<span class=\"cats-m\" aria-hidden=\"true\">' + [...c.cats].slice(0, 4).map(k => '<i style=\"--c:var(--c-' + k + ')\"></i>').join(\"\") + \"</span></button>\";\n  });\n  return '<section class=\"sec\" aria-label=\"Calendário de disponibilidade\"><div class=\"sec-h\"><h2>Calendário · ' + MESES[mi].n + \" \" + MESES[mi].y + '</h2><div class=\"seg\" role=\"group\" aria-label=\"Modo de consulta\">' +\n    '<button data-act=\"dmode\" data-v=\"dia\" aria-pressed=\"' + (S.dMode === \"dia\") + '\">Um dia</button><button data-act=\"dmode\" data-v=\"intervalo\" aria-pressed=\"' + (S.dMode === \"intervalo\") + '\">Intervalo</button></div></div>' +\n    '<div class=\"mtabs\" role=\"group\" aria-label=\"Mês\">' + MESES.map((M, i) => '<button data-act=\"dmonth\" data-i=\"' + i + '\" aria-pressed=\"' + (i === mi) + '\">' + M.n + \"</button>\").join(\"\") + \"</div>\" +\n    (S.dMode === \"intervalo\" ? '<p class=\"hint\" style=\"margin:8px 0 0\">' + (!S.rIni || S.rFim ? \"Toque no primeiro dia do intervalo (pode trocar de mês).\" : \"Agora toque no último dia do intervalo.\") + \"</p>\" : \"\") +\n    '<div class=\"dcal\"><div class=\"wk\" aria-hidden=\"true\">' + WD.map(w => \"<span>\" + w + \"</span>\").join(\"\") + '</div><div class=\"grid\">' + cells + \"</div></div>\" +\n    '<div class=\"legend\"><span>Nº = afastados no dia' + (filtroCatAtivo() ? \" (só tipos marcados)\" : \"\") + '</span><span>Mais escuro = mais afastados (o mais escuro é o dia de pico) <span class=\"heatkey\"><i style=\"--h:0%\"></i><i style=\"--h:20%\"></i><i style=\"--h:40%\"></i><i style=\"--h:60%\"></i><i style=\"--h:78%\"></i></span></span><span>▲ = apresentações</span><span>✕ = desligamentos</span><span>Faixas coloridas = motivos do dia</span><span><u>Sublinhado</u> = feriado nacional</span></div></section>';\n}\nfunction whyHtml(ps) { return ps.map(p => \"<span>\" + sw(p.cat) + esc(CAT[p.cat].n) + \" · \" + esc(intTxt(p)) + (p.obs ? \" · \" + esc(p.obs) : \"\") + \"</span>\").join(\"\"); }\nfunction renderDetail() {\n  if (S.dMode === \"intervalo\") return renderInterval();\n  const d = S.dSel, c = contDia(d);\n  const g = { disp: [], fora: [], pend: [], desl: [] };\n  milsFiltro().forEach(m => { const s = situacao(m.id, d); g[s.k].push({ m, s }); });\n  const foraOrd = g.fora.sort((a, b) => (catOn(b.s.ps[0].cat) ? 1 : 0) - (catOn(a.s.ps[0].cat) ? 1 : 0));\n  return '<section class=\"sec detail\" aria-label=\"Situação do dia\" aria-live=\"polite\"><span class=\"eyebrow\">Situação do dia</span><h3>' + esc(fw(d)) + \"</h3>\" +\n    (FERIADOS[d] ? '<p class=\"hint\" style=\"margin:2px 0 0\">Feriado nacional: ' + esc(FERIADOS[d]) + \"</p>\" : \"\") +\n    '<div class=\"mini\"><div><b class=\"num\">' + c.efetivo + \"</b><span>Efetivo</span></div><div><b class=\\\"num\\\" style=\\\"color:var(--ok)\\\">\" + c.disp + \"</b><span>Disponíveis</span></div><div><b class=\\\"num\\\" style=\\\"color:var(--bad)\\\">\" + c.fora + \"</b><span>Afastados</span></div><div><b class=\\\"num\\\" style=\\\"color:var(--pend)\\\">\" + c.pend + \"</b><span>Sem resposta</span></div></div>\" +\n    '<p class=\"hint\" style=\"margin:0;font-size:12px\">Efetivo = disponíveis + afastados + sem resposta' + (c.desl ? \" · \" + c.desl + \" já desligado\" + (c.desl > 1 ? \"s\" : \"\") + \" (fora do efetivo)\" : \"\") + (S.fMil !== \"todos\" ? \" · filtrado por militar\" : \"\") + \".</p>\" +\n    '<div class=\"grp\"><h4>Afastados (' + g.fora.length + \")</h4>\" + (g.fora.length ? '<ul class=\"who\">' + foraOrd.map(x => '<li style=\"' + (x.s.ps.some(p => catOn(p.cat)) ? \"\" : \"opacity:.6\") + '\"><strong>' + esc(x.m.nome) + '</strong><span class=\"why\">' + whyHtml(x.s.ps) + \"</span></li>\").join(\"\") + \"</ul>\" : '<p class=\"empty\">Ninguém afastado neste dia.</p>') + \"</div>\" +\n    '<div class=\"grp\"><h4>Disponíveis (' + g.disp.length + \")</h4>\" + (g.disp.length ? '<div class=\"names-inline\">' + g.disp.map(x => \"<span>\" + esc(x.m.nome) + (x.s.apres.length ? \" · ▲ apresenta-se hoje\" : \"\") + \"</span>\").join(\"\") + \"</div>\" : '<p class=\"empty\">Nenhum.</p>') + \"</div>\" +\n    (g.pend.length ? '<div class=\"grp\"><h4>Sem resposta (' + g.pend.length + \")</h4><div class=\\\"names-inline\\\">\" + g.pend.map(x => \"<span>○ \" + esc(x.m.nome) + \"</span>\").join(\"\") + \"</div></div>\" : \"\") +\n    (g.desl.length ? '<div class=\"grp\"><h4>Desligados (' + g.desl.length + \")</h4><div class=\\\"names-inline\\\">\" + g.desl.map(x => \"<span>✕ \" + esc(x.m.nome) + \" · desde \" + esc(f2(S.respostas[x.m.id].deslig)) + \"</span>\").join(\"\") + \"</div></div>\" : \"\") +\n    \"</section>\";\n}\nfunction renderInterval() {\n  if (!S.rIni) return '<section class=\"sec detail\"><span class=\"eyebrow\">Consulta de intervalo</span><h3>Escolha o intervalo</h3><p class=\"hint\">Toque no primeiro e no último dia no calendário. O resultado mostra quem estará fora, quantos ao mesmo tempo e o pico do período.</p></section>';\n  const a = S.rIni, b = S.rFim || S.rIni;\n  const dias = ALL_DAYS.filter(d => d >= a && d <= b);\n  const cont = dias.map(d => ({ d, c: contDia(d) }));\n  const mx = Math.max(...cont.map(x => x.c.foraF));\n  const picos = cont.filter(x => x.c.foraF === mx && mx > 0).map(x => x.d);\n  const minDisp = Math.min(...cont.map(x => x.c.disp));\n  const fora = [], todo = [], pend = [], desl = [];\n  milsFiltro().forEach(m => {\n    const r = S.respostas[m.id];\n    if (!r) { pend.push(m); return; }\n    if (r.temDeslig && r.deslig && r.deslig <= a) { desl.push(m); return; }\n    const ps = afastamentos(r).filter(p => valido(p) && p.ini <= b && p.fim >= a);\n    const nd = dias.filter(d => situacao(m.id, d).k === \"fora\").length;\n    if (ps.length) fora.push({ m, ps, nd }); else todo.push(m);\n  });\n  const bars = cont.map(x => '<i class=\"' + (x.c.foraF === mx && mx > 0 ? \"mx\" : \"\") + '\" style=\"height:' + (mx ? x.c.foraF / mx * 100 : 0) + '%\" title=\"' + esc(fs(x.d) + \": \" + x.c.foraF + \" fora\") + '\"></i>').join(\"\");\n  return '<section class=\"sec detail\" aria-label=\"Consulta de intervalo\" aria-live=\"polite\"><span class=\"eyebrow\">Consulta de intervalo</span><h3>' + esc(f2(a)) + (b !== a ? \" a \" + esc(f2(b)) : \"\") + \" · \" + dias.length + \" dia\" + (dias.length > 1 ? \"s\" : \"\") + \"</h3>\" +\n    '<div class=\"mini\"><div><b class=\"num\" style=\"color:var(--bad)\">' + mx + \"</b><span>Pico de afastados</span></div><div><b class=\\\"num\\\" style=\\\"color:var(--ok)\\\">\" + minDisp + \"</b><span>Mínimo disponível</span></div><div><b class=\\\"num\\\">\" + fora.length + \"</b><span>Fora em algum dia</span></div><div><b class=\\\"num\\\" style=\\\"color:var(--pend)\\\">\" + pend.length + \"</b><span>Sem resposta</span></div></div>\" +\n    (dias.length > 1 ? '<div class=\"peak\" aria-hidden=\"true\">' + bars + '</div><div class=\"peak-ax\"><span>' + esc(f2(a)) + \"</span><span>Afastados por dia (vermelho = pico)</span><span>\" + esc(f2(b)) + \"</span></div>\" : \"\") +\n    (picos.length ? '<p class=\"hint\" style=\"margin:8px 0 0\">Pico de ' + mx + \" afastados simultâneos em: \" + esc(picos.length > 6 ? picos.slice(0, 6).map(f2).join(\", \") + \" e mais \" + (picos.length - 6) + \" dias\" : picos.map(f2).join(\", \")) + \".</p>\" : \"\") +\n    '<div class=\"grp\"><h4>Afastados em algum dia (' + fora.length + \")</h4>\" + (fora.length ? '<ul class=\"who\">' + fora.map(x => \"<li><strong>\" + esc(x.m.nome) + ' · <span class=\"num\">' + x.nd + \"</span> de \" + dias.length + ' dias fora</strong><span class=\"why\">' + whyHtml(x.ps) + \"</span></li>\").join(\"\") + \"</ul>\" : '<p class=\"empty\">Ninguém afastado no intervalo.</p>') + \"</div>\" +\n    '<div class=\"grp\"><h4>Disponíveis durante todo o intervalo (' + todo.length + \")</h4>\" + (todo.length ? '<div class=\"names-inline\">' + todo.map(m => \"<span>\" + esc(m.nome) + \"</span>\").join(\"\") + \"</div>\" : '<p class=\"empty\">Nenhum.</p>') + \"</div>\" +\n    (pend.length ? '<div class=\"grp\"><h4>Sem resposta (' + pend.length + ')</h4><div class=\"names-inline\">' + pend.map(m => \"<span>○ \" + esc(m.nome) + \"</span>\").join(\"\") + \"</div></div>\" : \"\") +\n    (desl.length ? '<div class=\"grp\"><h4>Já desligados (' + desl.length + ')</h4><div class=\"names-inline\">' + desl.map(m => \"<span>✕ \" + esc(m.nome) + \"</span>\").join(\"\") + \"</div></div>\" : \"\") +\n    '<button class=\"btn sm\" data-act=\"rclear\" style=\"margin-top:12px\">Limpar intervalo</button></section>';\n}\nfunction renderMap() {\n  const scopeAll = S.mapScope === \"todo\";\n  const dias = scopeAll ? ALL_DAYS : mesDias(S.dMonth);\n  const a = dias[0], b = dias[dias.length - 1], tot = dias.length;\n  const pos = d => (dn(d) - dn(a)) / tot * 100;\n  const wk = dias.filter(d => wd(d) === 6).map(d => '<span class=\"wkend\" style=\"left:' + pos(d) + \"%;width:\" + (Math.min(2, ndias(d, b)) / tot * 100) + '%\"></span>').join(\"\") + (wd(a) === 0 ? '<span class=\"wkend\" style=\"left:0;width:' + (1 / tot * 100) + '%\"></span>' : \"\");\n  const ticks = scopeAll ? MESES.map((M, i) => { const d0 = mesDias(i)[0]; return '<span class=\"' + (i === 0 ? \"l0\" : \"\") + '\" style=\"left:' + pos(d0) + '%\">' + M.c + \"</span>\"; }).join(\"\") :\n    [1, 8, 15, 22, 29].filter(n => n <= tot).map(n => '<span class=\"' + (n === 1 ? \"l0\" : \"\") + '\" style=\"left:' + ((n - 1) / tot * 100) + '%\">' + n + \"</span>\").join(\"\");\n  const selLine = S.dMode === \"dia\" && S.dSel >= a && S.dSel <= b ? '<span class=\"seldayl\" style=\"left:' + (pos(S.dSel) + 50 / tot) + '%\"></span>' : \"\";\n  const rows = milsFiltro().map(m => {\n    const r = S.respostas[m.id], st = statusDe(m.id);\n    let inner = wk + selLine;\n    if (!r) inner += '<span class=\"pend\">Sem resposta</span>';\n    else {\n      afastamentos(r).filter(p => valido(p) && p.ini <= b && p.fim >= a).forEach(p => {\n        const s = p.ini < a ? a : p.ini, e = p.fim > b ? b : p.fim;\n        inner += '<span class=\"bar' + (CAT[p.cat].tex ? \" bar-tex\" : \"\") + (catOn(p.cat) ? \"\" : \" dim\") + '\" style=\"--c:var(--c-' + p.cat + \");--t:var(--t-\" + p.cat + \");left:\" + pos(s) + \"%;width:\" + (ndias(s, e) / tot * 100) + '%\"><span>' + esc(CAT[p.cat].n) + \"</span></span>\";\n      });\n      apresentacoes(r).filter(x => x.dia >= a && x.dia <= b).forEach(x => { inner += '<span class=\"apr\" style=\"left:' + pos(x.dia) + '%\"></span>'; });\n      if (r.temDeslig && r.deslig && r.deslig <= b) inner += '<span class=\"dsl\" style=\"left:' + pos(r.deslig < a ? a : r.deslig) + '%\"></span>';\n      if (st.k === \"bad\") inner += '<span class=\"badrow pill bad\">!</span>';\n    }\n    const lab = m.nome + \": \" + (!r ? \"sem resposta\" : afastamentos(r).filter(valido).map(p => CAT[p.cat].n + \" de \" + f3(p.ini) + \" a \" + f3(p.fim)).join(\"; \") || \"sem afastamentos\") + (r && r.temDeslig && r.deslig ? \"; desligamento em \" + f3(r.deslig) : \"\");\n    return '<button class=\"row\" data-act=\"who\" data-id=\"' + m.id + '\" aria-label=\"' + esc(lab) + '\"><span class=\"nm\">' + esc(m.nome) + '<small class=\"' + \"\" + '\" style=\"color:var(--' + (st.k === \"ok\" ? \"ok\" : st.k === \"bad\" ? \"bad\" : \"pend\") + ')\">' + (st.k === \"ok\" ? \"✓ respondido\" : st.k === \"bad\" ? \"! corrigir\" : \"○ pendente\") + '</small></span><span class=\"trk\">' + inner + \"</span></button>\";\n  }).join(\"\");\n  const usados = new Set(); Object.values(S.respostas).forEach(r => afastamentos(r).filter(valido).forEach(p => usados.add(p.cat)));\n  return '<section class=\"sec full\" aria-label=\"Mapa de afastamentos\"><div class=\"sec-h\"><h2>Mapa de afastamentos · ' + (scopeAll ? \"Nov/2026 a Jan/2027\" : MESES[S.dMonth].n) + '</h2><div class=\"seg\" role=\"group\" aria-label=\"Período do mapa\"><button data-act=\"mscope\" data-v=\"mes\" aria-pressed=\"' + !scopeAll + '\">Mês do calendário</button><button data-act=\"mscope\" data-v=\"todo\" aria-pressed=\"' + scopeAll + '\">Nov a Jan</button></div></div>' +\n    '<p class=\"hint\" style=\"margin:-4px 0 10px;font-size:13px\">Toque em uma linha para ver os períodos completos do militar.</p>' +\n    '<div class=\"axis\" aria-hidden=\"true\"><span></span><span class=\"ticks\">' + ticks + '</span></div><div class=\"map\">' + rows + \"</div>\" +\n    '<div class=\"legend\">' + CATS.filter(c => usados.has(c.k)).map(c => \"<span>\" + sw(c.k) + esc(c.n) + \"</span>\").join(\"\") +\n    '<span><i style=\"display:inline-block;width:0;height:12px;border-left:2px dashed var(--ink)\"></i> apresentação</span><span><i style=\"display:inline-block;width:16px;height:10px;background:repeating-linear-gradient(135deg,var(--muted) 0 2px,transparent 2px 6px)\"></i> após o desligamento</span><span>Faixa cinza listrada = sem resposta</span><span>Sombreado leve = fim de semana</span></div></section>';\n}\nfunction renderStatus(st) {\n  const col = (k, t, items) => '<div><div class=\"grp\" style=\"margin-top:0\"><h4>' + t + \" (\" + items.length + ')</h4><div class=\"stack\" style=\"gap:6px\">' + (items.length ? items.map(x => {\n    const r = S.respostas[x.m.id];\n    return '<div class=\"st-item\"><div><strong>' + esc(x.m.nome) + \"</strong><small>\" + (r ? \"Atualizado em \" + esc(fmtHora(r.atualizadoEm)) + (r.rev > 1 ? \" · \" + r.rev + \" versões\" : \"\") : \"Ainda não respondeu\") + \"</small></div>\" +\n      '<button class=\"btn sm\" data-act=\"openfor\" data-id=\"' + x.m.id + '\">' + (r ? \"Ver/corrigir\" : \"Preencher\") + \"</button>\" +\n      (k === \"bad\" ? \"<ul>\" + x.s.iss.filter(i => i.tipo !== \"aviso\").map(i => \"<li>\" + esc(i.msg) + \"</li>\").join(\"\") + \"</ul>\" : \"\") +\n      (k === \"ok\" && x.s.iss.length ? \"<ul>\" + x.s.iss.map(i => \"<li>Atenção: \" + esc(i.msg) + \"</li>\").join(\"\") + \"</ul>\" : \"\") + \"</div>\";\n  }).join(\"\") : '<p class=\"empty\">Nenhum.</p>') + \"</div></div></div>\";\n  return '<section class=\"sec full\" id=\"status\" aria-label=\"Situação das respostas\"><div class=\"sec-h\"><h2>Respostas</h2><p>' + st.filter(x => x.s.k !== \"pend\").length + \" de 13 responderam</p></div><div class=\\\"status-cols\\\">\" +\n    col(\"bad\", \"! Precisam corrigir\", st.filter(x => x.s.k === \"bad\")) + col(\"pend\", \"○ Pendentes\", st.filter(x => x.s.k === \"pend\")) + col(\"ok\", \"✓ Respondidos\", st.filter(x => x.s.k === \"ok\")) + \"</div></section>\";\n}\nfunction renderDates() {\n  const ev = [];\n  milsFiltro().forEach(m => {\n    const r = S.respostas[m.id]; if (!r) return;\n    apresentacoes(r).forEach(a => ev.push({ d: a.dia, t: \"Apresentação\", m, x: \"Fim de \" + CAT[a.de.cat].n + \" (\" + intTxt(a.de) + \")\" }));\n    if (r.temDeslig && r.deslig) ev.push({ d: r.deslig, t: \"Desligamento\", m, x: \"Deixa de contar no efetivo a partir desta data\" });\n  });\n  ev.sort((a, b) => a.d < b.d ? -1 : a.d > b.d ? 1 : a.m.nome < b.m.nome ? -1 : 1);\n  return '<section class=\"sec full\" aria-label=\"Apresentações e desligamentos\"><div class=\"sec-h\"><h2>Apresentações e desligamentos</h2><p>Apresentação = dia seguinte ao fim do afastamento</p></div>' +\n    (ev.length ? '<ul class=\"evl\">' + ev.map(e => '<li><span class=\"evd num\"><b>' + esc(f2(e.d)) + \"</b>\" + WD[wd(e.d)] + \" · \" + e.d.slice(0, 4) + '</span><span><strong>' + (e.t === \"Apresentação\" ? \"▲ Apresentação\" : \"✕ Desligamento\") + \" · \" + esc(e.m.nome) + \"</strong><small>\" + esc(e.x) + \"</small></span></li>\").join(\"\") + \"</ul>\" :\n      '<p class=\"empty\">Nenhuma data registrada ainda.</p>') + \"</section>\";\n}\nfunction whoModal(id) {\n  const r = S.respostas[id], st = statusDe(id);\n  const layer = document.getElementById(\"layer\");\n  layer.innerHTML = '<div class=\"modal\" data-act=\"mclose\"><div class=\"card\" role=\"dialog\" aria-modal=\"true\" aria-label=\"' + esc(NOME[id]) + '\" data-stop=\"1\"><div class=\"sec-h\"><h2>' + esc(NOME[id]) + \"</h2>\" + pill(st) + \"</div>\" +\n    (r ? personStrip(r) + resumoLista(r) + (st.iss.length ? issuesHtml(st.iss, false) : \"\") + '<p class=\"hint\" style=\"margin-top:10px\">Atualizado em ' + esc(fmtHora(r.atualizadoEm)) + \"</p>\" : '<p class=\"empty\">Ainda não respondeu. Não é contado como disponível.</p>') +\n    '<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px\"><button class=\"btn\" data-act=\"mclose\">Fechar</button><button class=\"btn pri\" data-act=\"openfor\" data-id=\"' + id + '\">' + (r ? \"Corrigir resposta\" : \"Preencher\") + \"</button></div></div></div>\";\n  const b = layer.querySelector('[data-act=\"mclose\"].btn'); if (b) b.focus();\n}\nfunction toast(t) { const l = document.createElement(\"div\"); l.className = \"toast\"; l.setAttribute(\"role\", \"status\"); l.textContent = t; document.body.appendChild(l); setTimeout(() => l.remove(), 2600); }\n\n/* ======================= ações ======================= */\nfunction pickMilitar(id) {\n  S.mid = id; S.staleRemote = null; S.confirmConflito = false;\n  const r = S.respostas[id];\n  S.draft = r ? clone(r) : novoRegistro(id);\n  S.baseRev = r ? (r.rev || 0) : 0;\n  // Militar: a conta tem um único documento; trocar de nome substitui a resposta anterior desta conta.\n  S.trocaDe = null;\n  if (!S.gestor && S.meu && S.meu.id !== id) { S.baseRev = S.meu.rev || 0; S.trocaDe = S.meu.id; }\n  S.loaded = JSON.stringify(S.draft);\n}\nfunction scrollTop() { try { window.scrollTo({ top: 0 }); } catch (e) {} }\nasync function enviar() {\n  const iss = validar(S.draft);\n  if (bloqueia(iss)) return;\n  if (temConflito(iss) && !S.confirmConflito) { S.confirmConflito = true; render(); return; }\n  S.sending = true; render();\n  try {\n    const rec = clone(S.draft); rec.militar = NOME[rec.id];\n    const res = await S.backend.save(rec, S.baseRev);\n    if (res && res.ok) {\n      S.respostas[rec.id] = res.registro; S.sent = rec.id; S.baseRev = res.registro.rev; S.staleRemote = null; S.confirmConflito = false;\n    } else if (res && res.conflict) {\n      S.staleRemote = res.current || null;\n      toast(\"Esta resposta foi alterada em outro aparelho. Escolha qual versão manter.\");\n    } else toast(\"Não foi possível enviar. Tente de novo.\");\n  } catch (e) {\n    toast(e && e.code === \"invalid_argument\" ? \"Sem permissão para gravar na base. Peça acesso de edição ao Maj Modesto.\" : \"Falha ao enviar: \" + (e && e.message || e));\n  }\n  S.sending = false; render(); scrollTop();\n}\ndocument.addEventListener(\"click\", ev => {\n  const t = ev.target.closest(\"[data-act]\");\n  if (!t) return;\n  if (t.dataset.act === \"mclose\" && ev.target.closest(\"[data-stop]\") && !ev.target.closest(\".btn\")) return;\n  const a = t.dataset.act, d = t.dataset;\n  const e = S.editing;\n  switch (a) {\n    case \"view\": if (!S.gestor) return; S.view = d.v; try { history.replaceState(null, \"\", d.v === \"dash\" ? \"#painel\" : \"#\"); } catch (x) {} render(); scrollTop(); return;\n    case \"pick\": if (S.backend && S.backend.loadOne) { const id = d.id; S.backend.loadOne(id).then(() => { const had = !!S.respostas[id]; pickMilitar(id); S.step = had ? 4 : 1; render(); scrollTop(); if (had) toast(\"Sua resposta foi carregada. Revise e corrija o que precisar.\"); }); return; }\n    { const had = !!S.respostas[d.id]; pickMilitar(d.id); S.step = had ? 4 : 1; render(); scrollTop(); if (had) toast(\"Sua resposta foi carregada. Revise e corrija o que precisar.\"); return; }\n    case \"step\": if (S.mid) { S.step = +d.i; S.editing = null; S.confirmConflito = false; render(); scrollTop(); } return;\n    case \"next\": if (S.mid) { S.step = Math.min(4, S.step + 1); S.confirmConflito = false; if (S.step === 3 && S.draft.deslig) S.pickMonth = MESES.findIndex(M => +S.draft.deslig.slice(5, 7) - 1 === M.m); render(); scrollTop(); } return;\n    case \"prev\": S.step = Math.max(0, S.step - 1); S.confirmConflito = false; render(); scrollTop(); return;\n    case \"new\": S.editing = { id: \"p\" + uid(), cat: null, ini: null, fim: null, obs: \"\", isNew: true }; S.pickStage = \"ini\"; render(); scrollTop(); return;\n    case \"edit\": { const p = S.draft.periodos.find(x => x.id === d.pid); if (!p) return; S.editing = { ...clone(p), isNew: false }; S.pickStage = \"ini\"; S.pickMonth = p.ini ? Math.max(0, MESES.findIndex(M => +p.ini.slice(5, 7) - 1 === M.m)) : 1; render(); scrollTop(); return; }\n    case \"del\": S.draft.periodos = S.draft.periodos.filter(x => x.id !== d.pid); render(); toast(\"Afastamento removido. Lembre-se de enviar no final.\"); return;\n    case \"ecat\": e.cat = d.k; render(); return;\n    case \"pmonth\": S.pickMonth = +d.i; render(); return;\n    case \"pday\": {\n      const day = d.d;\n      if (S.pickStage === \"ini\" || !e.ini) { e.ini = day; e.fim = null; S.pickStage = \"fim\"; }\n      else if (day < e.ini) { e.ini = day; e.fim = null; S.pickStage = \"fim\"; }\n      else { e.fim = day; S.pickStage = \"ini\"; }\n      render(); return;\n    }\n    case \"ecancel\": S.editing = null; render(); scrollTop(); return;\n    case \"esave\": {\n      if (CAT[e.cat] && CAT[e.cat].fixa) { S.draft.dispensa = e.cat; S.draft.periodos = S.draft.periodos.filter(x => x.id !== e.id); S.editing = null; render(); toast(CAT[e.cat].n + \" registrada com as datas fixas.\"); return; }\n      const obs = (document.getElementById(\"obs\") || {}).value || \"\";\n      const p = { id: e.id, cat: e.cat, ini: e.ini, fim: e.fim }; if (obs.trim()) p.obs = obs.trim().slice(0, 120);\n      const i = S.draft.periodos.findIndex(x => x.id === e.id);\n      if (i >= 0) S.draft.periodos[i] = p; else S.draft.periodos.push(p);\n      S.draft.periodos.sort((x, y) => x.ini < y.ini ? -1 : 1);\n      S.editing = null; render(); scrollTop(); return;\n    }\n    case \"disp\": S.draft.dispensa = d.k; render(); return;\n    case \"tdes\": S.draft.temDeslig = d.v === \"1\"; if (!S.draft.temDeslig) S.draft.deslig = null; else S.pickMonth = S.draft.deslig ? MESES.findIndex(M => +S.draft.deslig.slice(5, 7) - 1 === M.m) : 2; render(); return;\n    case \"dday\": S.draft.deslig = d.d; render(); return;\n    case \"send\": enviar(); return;\n    case \"loadRemote\": pickMilitar(S.mid); render(); return;\n    case \"keepMine\": S.baseRev = S.staleRemote.rev || 0; S.staleRemote = null; render(); return;\n    case \"reedit\": { const id = S.sent; S.sent = null; pickMilitar(id); S.step = 1; render(); scrollTop(); return; }\n    case \"restart\": S.sent = null; S.mid = null; S.draft = null; S.step = 0; render(); scrollTop(); return;\n    // painel\n    case \"dmonth\": S.dMonth = +d.i; render(); return;\n    case \"dmode\": S.dMode = d.v; render(); return;\n    case \"dsel\": {\n      if (S.dMode === \"dia\") S.dSel = d.d;\n      else if (!S.rIni || S.rFim) { S.rIni = d.d; S.rFim = null; }\n      else if (d.d < S.rIni) { S.rFim = S.rIni; S.rIni = d.d; }\n      else S.rFim = d.d;\n      render(); return;\n    }\n    case \"rclear\": S.rIni = S.rFim = null; render(); return;\n    case \"fcat\": if (S.fCats.has(d.k)) S.fCats.delete(d.k); else S.fCats.add(d.k); render(); return;\n    case \"fall\": S.fCats = filtroCatAtivo() ? new Set(CATS.map(c => c.k)) : new Set(); render(); return;\n    case \"fclear\": S.fCats = new Set(CATS.map(c => c.k)); S.fMil = \"todos\"; render(); return;\n    case \"mscope\": S.mapScope = d.v; render(); return;\n    case \"who\": whoModal(d.id); return;\n    case \"mclose\": document.getElementById(\"layer\").innerHTML = \"\"; return;\n    case \"openfor\": if (!S.gestor) return; document.getElementById(\"layer\").innerHTML = \"\"; S.view = \"form\"; S.sent = null; S.editing = null; pickMilitar(d.id); S.step = S.respostas[d.id] ? 4 : 1; render(); scrollTop(); return;\n  }\n});\ndocument.addEventListener(\"toggle\", ev => { if (ev.target.id === \"filtros\") S.filtersOpen = ev.target.open; }, true);\ndocument.addEventListener(\"change\", ev => {\n  if (ev.target.id === \"fmil\") { S.fMil = ev.target.value; render(); }\n});\ndocument.addEventListener(\"input\", ev => { if (ev.target.id === \"obs\" && S.editing) S.editing.obs = ev.target.value; });\ndocument.addEventListener(\"keydown\", ev => { if (ev.key === \"Escape\" && document.getElementById(\"layer\").innerHTML) document.getElementById(\"layer\").innerHTML = \"\"; });\n\nrender();\ninitBackend();\n</script>\n";
